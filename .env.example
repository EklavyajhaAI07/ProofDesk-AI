# Supabase Configuration (Required)
# Get these from your Supabase dashboard: Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI API Key (Required for AI processing)
# Get this from https://console.groq.com/keys
VITE_GROQ_API_KEY=your-groq-api-key

# Email Service (Required for email notifications)
# Get this from https://resend.com/api-keys
VITE_RESEND_API_KEY=your-resend-api-key

# Supabase Service Role Key (Required for edge functions / server-side)
# Get this from your Supabase dashboard: Project Settings > API > service_role key
# WARNING: Keep this secret! Never expose in client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in ALL values above with your actual credentials
# 3. Restart the dev server after making changes: npx vite --port 5173
# 4. Run the SQL migration in Supabase dashboard SQL Editor (supabase/migrations/00001_init_proofdesk_schema.sql)
# 5. Add your email to the allowed_users table: INSERT INTO allowed_users (email) VALUES ('your@email.com');